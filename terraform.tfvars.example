aws_region = "us-east-1"

# Set this to your current public IPv4 address with /32.
# Example format only: "203.0.113.25/32"
admin_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

domain_name  = "corp.example"
netbios_name = "CORP"

# Replace these. Do not commit real passwords or terraform.tfvars.
local_admin_password = "Replace-This-With-A-Unique-Password-1!"
dsrm_password        = "Replace-This-With-A-Different-Password-2!"